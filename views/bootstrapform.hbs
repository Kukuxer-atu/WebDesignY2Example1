<h1 class="mb-4">Holiday Booking Form</h1>

    <form action="https://httpbin.org/post" method="post" id="form">
        <div class="form-floating mb-1">
            <input type="text"
                   class="form-control"
                   id="name"
                   name="name"
                   placeholder="Full Name"
                   aria-describedby="nameHelp"
                   required>

            <label for="name">Full Name</label>
        </div>

        <p class="form-text mb-3" id="nameHelp">
            Please use the name on your passport or driving licence.
        </p>

        <div class="mb-3">
            <label for="password" class="form-label">
                Account Password:
            </label>

            <input type="password"
                   class="form-control"
                   id="password"
                   name="password">
        </div>

        <!-- Special Requests -->
        <div class="mb-3">
            <label for="comments" class="form-label">
                Special Requests:
            </label>

            <textarea class="form-control"
                      id="comments"
                      name="comments"
                      rows="4"></textarea>
        </div>

        <fieldset class="mb-3 border rounded p-3">
            <legend class="float-none w-auto px-2">
                Extras
            </legend>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="breakfast"
                       name="extras"
                       value="Breakfast">

                <label class="form-check-label" for="breakfast">
                    Breakfast Included
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="parking"
                       name="extras"
                       value="Parking">

                <label class="form-check-label" for="parking">
                    Parking Space
                </label>
            </div>
        </fieldset>

        <!-- Radio Buttons -->
        <fieldset class="mb-3 border rounded p-3">
            <legend class="float-none w-auto px-2">
                Room Type
            </legend>

            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       id="single"
                       name="room"
                       value="Single">

                <label class="form-check-label" for="single">
                    Single Room
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       id="double"
                       name="room"
                       value="Double">

                <label class="form-check-label" for="double">
                    Double Room
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       id="family"
                       name="room"
                       value="Family">

                <label class="form-check-label" for="family">
                    Family Room
                </label>
            </div>
        </fieldset>

        <!-- Destination -->
        <div class="mb-3">
            <label for="destination" class="form-label">
                Destination:
            </label>

            <select class="form-select"
                    id="destination"
                    name="destination">

                <option value="">Choose a destination</option>
                <option value="sligo">Sligo</option>
                <option value="galway">Galway</option>
                <option value="cork">Cork</option>
                <option value="dublin">Dublin</option>
            </select>
        </div>

        <!-- Multiple Select -->
        <div class="mb-3">
            <label for="activities" class="form-label">
                Activities:
            </label>

            <select class="form-select"
                    id="activities"
                    name="activities"
                    multiple
                    size="4">

                <option value="hiking">Hiking</option>
                <option value="surfing">Surfing</option>
                <option value="cycling">Cycling</option>
                <option value="boat-trip">Boat Trip</option>
            </select>

            <div class="form-text">
                Hold Ctrl or Cmd to select multiple activities.
            </div>
        </div>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="switchCheckDefault"
                   name="switchCheckDefault">

            <label class="form-check-label"
                   for="switchCheckDefault">
                Demo purposes only, this is a switch input
            </label>
        </div>

        <!-- Read-only example -->
        <div class="mb-3">
            <label for="bookingReference" class="form-label">
                Booking Reference (read-only):
            </label>

            <input type="text"
                   class="form-control-plaintext"
                   id="bookingReference"
                   name="bookingReference"
                   value="HOLIDAY123"
                   readonly>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">
            Book Holiday
        </button>

    </form>