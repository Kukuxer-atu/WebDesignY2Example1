<body>

    <div class="responsive-card">

        <picture>
            <!-- Mobile -->
            <source
                media="(max-width: 600px)"
                srcset="https://plus.unsplash.com/premium_photo-1733259709671-9dbf22bf02cc?q=80&w=500">

            <!-- Tablet -->
            <source
                media="(max-width: 1024px)"
                srcset="https://plus.unsplash.com/premium_photo-1733259709671-9dbf22bf02cc?q=80&w=700">

            <!-- Desktop -->
            <img
                src="https://plus.unsplash.com/premium_photo-1733259709671-9dbf22bf02cc?q=80&w=880"
                alt="Pepperoni pizza">
        </picture>

        <div class="responsive-card-content">
            <h2>Pepperoni Pizza</h2>
            <p>Fresh tomato, mozzarella and pepperoni.</p>
        </div>

    </div>

</body>