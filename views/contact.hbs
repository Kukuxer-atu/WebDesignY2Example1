<main>
      <div class="contact-wrapper">
        <div class="contact-card">
          <h1>Contact Kuku-Pizza</h1>

          <p class="role">👨‍💻 Software Developer & Pizza Maker 🍕</p>

          <div class="contact-item">
            <span>Yevhenii Porkul</span>
          </div>

          <!-- INTERNAL + EXTERNAL LINKS -->
          <div class="contact-item">
            <a href="#form">Go to Contact Form ↓</a>
          </div>

          <div class="contact-item">
            <a
              href="https://www.youtube.com/watch?v=bvtvB3-Sc7o"
              target="_blank"
              >How to make a pizza</a
            >
          </div>

          <div class="contact-item">
            <a href="https://github.com/Kukuxer-atu" target="_blank">
              github.com/Kukuxer-atu
            </a>
          </div>

          <div class="contact-item">
            <a href="https://instagram.com/kukuxer" target="_blank">
              @kukuxer
            </a>
          </div>
        </div>

        <img
          src="https://images.unsplash.com/photo-1594007654729-407eedc4be65"
          class="float-img"
          alt="Pizza"
        />

        <form id="form" class="contact-form"  method="GET" action="/valuessubmitted">
          <h2>Send Us a Message</h2>

          <label>Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" placeholder="Jonh Pork" required />

          <label>Student Email <span class="required">*</span></label>
          <input type="email" id="email" name="email" placeholder="JonhPork@atu.ie" required/>

          <label>Year of Study <span class="required">*</span></label>
          <input type="number" id="YoS" name="yos" required/>

          <label>Date of Birth<span class="required">*</span></label>
          <input type="date" id="date" name="date" required/>

          

          <fieldset>
           <legend>Gender:</legend>

          
          <input type="radio" id="male" name="gender" value="male"  required/>
          <label for="male">Male</label>

          <input type="radio" id="female" name="gender" value="female"  />
           <label for="female">Female</label>

          </fieldset>

          <label>Course <span class="required">*</span></label>
          <input type="text" id="course" name="course" placeholder="Jonh Pork course" required/>

          <label> Mobile Phone Number <span class="required">*</span></label>
          <input type="tel" id="phone" name="phone" placeholder="777777" required/>

          <label>Club Name <span class="required">*</span></label>
          <input type="text" id="club" name="club" required/>

          

          <button type="submit">Submit</button>

          <p id="form-msg"></p>
        </form>
      </div>
 </main>
